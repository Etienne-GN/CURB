post_install() {
    # Create the curb system group
    if ! getent group curb > /dev/null 2>&1; then
        groupadd --system curb
    fi

    # setgid: binaries run as group curb — no logout required
    chown root:curb /usr/bin/curb
    chmod g+s       /usr/bin/curb
    if [ -f /usr/bin/curb-gui ]; then
        chown root:curb /usr/bin/curb-gui
        chmod g+s       /usr/bin/curb-gui
    fi

    systemctl daemon-reload
    systemctl enable --now curbd.service

    echo ""
    echo "CURB installed."
    echo "  curb apps      — live per-application traffic"
    echo "  curb-gui       — graphical interface"
}

post_upgrade() {
    systemctl daemon-reload
    systemctl restart curbd.service
}

pre_remove() {
    systemctl stop curbd.service 2>/dev/null || true
    systemctl disable curbd.service 2>/dev/null || true
}
