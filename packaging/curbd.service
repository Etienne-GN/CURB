[Unit]
Description=CURB — per-application bandwidth-control daemon
Documentation=https://github.com/Etienne-GN/CURB
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/curbd
Restart=on-failure
RestartSec=2

# Run as root (required for eBPF, tc, and cgroup manipulation), but set the
# supplementary group to `curb` so the control socket (/run/curbd/curbd.sock)
# is created with group ownership `curb` and mode 0660.  Members of the `curb`
# group can then control the daemon without root.
Group=curb

# Minimal capabilities — no full root privileges at the OS level.
# CAP_DAC_READ_SEARCH: required to open /proc/<pid>/fd/ for other-user processes
#   (kernel 6.x: generic_permission on proc/fd denies unless dac_read_search is held).
# CAP_SYS_PTRACE: required to read symlinks inside those fd dirs and to cross-reference
#   socket inodes for per-app traffic attribution.
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

# Hardening
NoNewPrivileges=yes
# ProtectSystem=strict is intentionally omitted: it would hide /sys and /etc
# paths needed for eBPF and tc operations.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
RestrictNamespaces=no
SystemCallArchitectures=native
LockPersonality=yes

# /run/curbd/curbd.sock lives here; systemd creates and owns the directory.
RuntimeDirectory=curbd
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
