#!/bin/sh
# Debian postinst script for the curb package.
set -e

case "$1" in
configure)
    # Create the curb system group (idempotent).
    if ! getent group curb > /dev/null 2>&1; then
        groupadd --system curb
    fi

    # setgid bit on the CLI so it can reach the socket without the user
    # having to log out and back in. The GUI cannot use setgid because GTK
    # refuses to initialize when effective GID != real GID.
    chown root:curb /usr/local/bin/curb
    chmod g+s       /usr/local/bin/curb

    # For the GUI, add the installing user to the curb group instead.
    INSTALL_USER="${SUDO_USER:-}"
    if [ -n "$INSTALL_USER" ] && [ "$INSTALL_USER" != "root" ]; then
        usermod -aG curb "$INSTALL_USER" 2>/dev/null || true
        echo "  Added '$INSTALL_USER' to the 'curb' group."
        echo "  Log out and back in (or run: newgrp curb) for curb-gui to work."
    else
        echo "  Add yourself to the 'curb' group for curb-gui:"
        echo "    sudo usermod -aG curb \$USER  (then log out/in)"
    fi

    # Enable and start the daemon.
    if command -v systemctl > /dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
        systemctl daemon-reload
        systemctl enable curbd.service
        systemctl restart curbd.service || true
    fi

    echo ""
    echo "CURB installed."
    echo "  curb apps      — live per-application traffic"
    echo "  curb-gui       — graphical interface"
    ;;
abort-upgrade|abort-remove|abort-deconfigure)
    ;;
*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
