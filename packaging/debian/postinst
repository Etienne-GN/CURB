#!/bin/sh
# Debian postinst script for the curb package.
set -e

case "$1" in
configure)
    # Create the curb system group (idempotent).
    if ! getent group curb > /dev/null 2>&1; then
        groupadd --system curb
    fi

    # setgid so the CLI and GUI reach the socket without the user having to
    # log out and back in. GTK refuses setgid, so /usr/local/bin/curb-gui is a
    # small launcher that switches to group curb and execs the real GUI.
    chown root:curb /usr/local/bin/curb
    chmod g+s       /usr/local/bin/curb
    if [ -f /usr/local/bin/curb-gui ]; then
        chown root:curb /usr/local/bin/curb-gui
        chmod g+s       /usr/local/bin/curb-gui
    fi

    # Create the persistent state directory for usage and quota data.
    install -d -m 755 -o root -g curb /var/lib/curb

    # Enable and start the daemon.
    if command -v systemctl > /dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
        systemctl daemon-reload
        systemctl enable curbd.service
        systemctl restart curbd.service || true
    fi

    # Refresh icon cache so the app menu shows the CURB icon immediately.
    if command -v gtk-update-icon-cache > /dev/null 2>&1; then
        gtk-update-icon-cache -qtf /usr/share/icons/hicolor 2>/dev/null || true
    fi
    if command -v update-desktop-database > /dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi

    echo ""
    echo "CURB installed."
    echo "  curb apps      — live per-application traffic"
    echo "  curb-gui       — graphical interface"
    ;;
abort-upgrade|abort-remove|abort-deconfigure)
    ;;
*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
