#!/bin/sh
# Debian postinst script for the curb package.
set -e

case "$1" in
configure)
    # Create the curb system group (idempotent).
    if ! getent group curb > /dev/null 2>&1; then
        groupadd --system curb
    fi

    # setgid bit: binaries run as group curb so the socket is accessible
    # immediately from any terminal or desktop shortcut — no logout required.
    chown root:curb /usr/local/bin/curb
    chmod g+s       /usr/local/bin/curb
    if [ -f /usr/local/bin/curb-gui ]; then
        chown root:curb /usr/local/bin/curb-gui
        chmod g+s       /usr/local/bin/curb-gui
    fi

    # Enable and start the daemon.
    if command -v systemctl > /dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
        systemctl daemon-reload
        systemctl enable curbd.service
        systemctl restart curbd.service || true
    fi

    echo ""
    echo "CURB installed."
    echo "  curb apps      — live per-application traffic"
    echo "  curb-gui       — graphical interface"
    ;;
abort-upgrade|abort-remove|abort-deconfigure)
    ;;
*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
